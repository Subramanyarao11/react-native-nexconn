<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Installs the push event listener at process start so a notification
         tap that cold-starts the app reaches JS (push.getInitialNotification).
         Remove with tools:node="remove" if your app manages RongPush itself. -->
    <provider
      android:name="com.nexconn.bridge.NexconnPushInitProvider"
      android:authorities="${applicationId}.nexconn-push-init"
      android:exported="false" />
  </application>
</manifest>

{
  "name": "@subramanyarao11/react-native-nexconn",
  "version": "0.1.0-beta.0",
  "description": "Community React Native SDK for Nexconn Chat: typed client, React hooks, Expo config plugin and test doubles for Community CLI and Expo development builds. Not affiliated with Nexconn.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-nexconn-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./react": {
      "react-native-nexconn-source": "./src/react/index.ts",
      "types": "./lib/typescript/src/react/index.d.ts",
      "default": "./lib/module/react/index.js"
    },
    "./testing": {
      "react-native-nexconn-source": "./src/testing/index.ts",
      "types": "./lib/typescript/src/testing/index.d.ts",
      "default": "./lib/module/testing/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "android/consumer-rules.pro",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "plugin",
    "app.plugin.js",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-nexconn-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "example:expo": "yarn workspace react-native-nexconn-example",
    "example:cli": "yarn workspace react-native-nexconn-cli-example",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "test:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/live/*.live.test.mjs",
    "build": "bob build",
    "check": "yarn test && yarn test:react && yarn typecheck && yarn lint && yarn build",
    "test:react": "jest",
    "bench": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/bench-events.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "nexconn",
    "chat",
    "messaging",
    "expo",
    "turbo-module",
    "react-hooks",
    "chat-sdk",
    "push-notifications",
    "new-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Subramanyarao11/react-native-nexconn.git"
  },
  "author": "Subramanya <90202645+Subramanyarao11@users.noreply.github.com> (https://github.com/Subramanyarao11)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Subramanyarao11/react-native-nexconn/issues"
  },
  "homepage": "https://subramanyarao11.github.io/react-native-nexconn/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "29.7.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "test-renderer": "1.3.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4"
  },
  "peerDependencies": {
    "expo": ">=58.0.0",
    "react": "^19.3.0",
    "react-native": "0.88.x"
  },
  "workspaces": [
    "example",
    "example-cli"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "NexconnSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.nexconn"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "roots": [
      "<rootDir>/tests/react"
    ],
    "testMatch": [
      "**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "configFile": false,
          "babelrc": false,
          "presets": [
            "module:@react-native/babel-preset"
          ]
        }
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/",
      "<rootDir>/example-cli/",
      "<rootDir>/lib/"
    ]
  }
}
